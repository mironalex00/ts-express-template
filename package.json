{
  "author": "Alexandru Ramon Miron",
  "name": "backend",
  "version": "0.0.1",
  "description": "",
  "scripts": {
    "dev": "nodemon",
    "prepare-build": "node ./prepare-build.mjs",
    "build-tsc": "npx -p typescript tsc",
    "build": "conc \"pnpm run prepare-build\" \"pnpm run build-tsc\" ",
    "start": "node --env-file-if-exists=.env -r module-alias/register build/main/app.js",
    "test": "jest"
  },
  "_moduleAliases": {
    "@logger": "build/main/infrastructure/logging/logger.js",
    "@server": "build/main/interfaces/http/server.js",
    "@status-codes": "build/main/shared/utils/status-codes.js",
    "@application": "build/main/application",
    "@domain": "build/main/domain",
    "@config": "build/main/infrastructure/config",
    "@database": "build/main/infrastructure/db",
    "@controllers": "build/main/interfaces/http/controllers",
    "@middlewares": "build/main/interfaces/http/middlewares",
    "@routes": "build/main/interfaces/http/routes",
    "@shared": "build/main/shared",
    "@shared-types": "build/main/shared/types",
    "@errors": "build/main/shared/errors",
    "@utils": "build/main/shared/utils"
  },
  "keywords": [
    "node",
    "fast-api",
    "typescript",
    "application"
  ],
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "module-alias": "^2.2.3",
    "swagger-ui-express": "^5.0.1",
    "tsoa": "^6.6.0",
    "winston": "^3.17.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.7",
    "@types/swagger-ui-express": "^4.1.7",
    "concurrently": "^9.1.2",
    "dotenv": "^16.4.7",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^15.4.1",
    "nodemon": "^3.1.9",
    "prettier": "^3.4.2",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3"
  }
}